        {
          "label": "根据置信区间不包含 1 判断统计显著",
          "points": 3,
          "keyword_groups": [
            ["置信区间", "95% CI", "CI"],
            ["不包含 1", "没有跨过 1", "不跨 1"],
            ["统计显著", "有统计学意义", "显著"]
          ]
        },
        {
          "label": "指出观察性结果不能直接推出因果",
          "points": 2,
          "keyword_groups": [
            ["因果", "导致", "造成"],
            ["混杂", "调整变量", "不能直接", "不能证明"]
          ]
        },
        {
          "label": "能描述方向和效应大小",
          "points": 2,
          "keyword_groups": [
            ["增加", "升高", "更高", "正相关"],
            ["1.45", "45%", "效应大小"]
          ]
        }
      ],
      "explanation": "OR 大于 1 且置信区间不跨 1，提示暴露与结局 odds 升高相关，但仍需注意混杂和因果限制。"
